  "userNodes": {
    "operator-mission_status": {
      "name": "mission_status",
      "sourceCode": "// Mission status for the operator display (display only: nothing is sent to ROS).\n// Parses the JSON in /sim/status and derives one warning code for the Indicator panels.\n// /tf is used only as a heartbeat so a silent /sim/status is reported as STATUS_STALE.\n// Thresholds: pose/scan 0.5 s match simulation_navigation.py; status 1.0 s is display-only.\n\nexport const inputs = [\"/sim/status\", \"/tf\"];\nexport const output = \"/studio_script/mission_status\";\n\ntype Time = { sec: number; nsec: number };\ntype InputEvent = { topic: string; receiveTime: Time; message: any };\n\ntype MissionStatus = {\n  state: string;\n  data_origin: string;\n  warning: string;\n  status_link: string;\n  scan: string;\n  pose: string;\n  status_age_s: number;\n  scan_age_s: number;\n  pose_age_s: number;\n  simulation_time_s: number;\n  battery: string;\n  estop: string;\n  faults: string;\n};\n\nconst STATUS_STALE_S = 1.0;\nconst SCAN_STALE_S = 0.5;\nconst POSE_STALE_S = 0.5;\n// The navigator reports ~1e9 s before a sensor's first message.\nconst NEVER_RECEIVED_S = 1e6;\n\nlet lastStatus: any = undefined;\nlet lastStatusTime: number | undefined = undefined;\n\nfunction seconds(t: Time): number {\n  return t.sec + t.nsec * 1e-9;\n}\n\nfunction freshness(age: unknown, limit: number): string {\n  if (typeof age !== \"number\" || !isFinite(age) || age >= NEVER_RECEIVED_S) {\n    return \"NO_DATA\";\n  }\n  return age >= 0 && age <= limit ? \"OK\" : \"STALE\";\n}\n\nfunction warningFor(state: string, link: string, scan: string, pose: string, origin: string): string {\n  if (link !== \"OK\") return \"STATUS_STALE\";\n  if (state === \"unparseable_status\") return \"STATUS_UNREADABLE\";\n  if (state === \"invalid_clock\") return \"INVALID_CLOCK\";\n  if (state === \"obstacle_stop\") return \"OBSTACLE_STOP\";\n  if (state === \"no_observed_path\") return \"NO_PATH\";\n  // Before the first scan/pose the navigator waits; only data that arrived and then aged is stale.\n  const waiting = state === \"waiting_for_sensors\";\n  if (scan === \"STALE\" || (scan === \"NO_DATA\" && !waiting)) return \"SCAN_STALE\";\n  if (pose === \"STALE\" || (pose === \"NO_DATA\" && !waiting)) return \"POSE_STALE\";\n  if (waiting) return \"WAITING_FOR_SENSORS\";\n  if (state === \"paused\") return \"PAUSED\";\n  if (origin !== \"SIMULATED\") return \"UNLABELLED_SOURCE\";\n  return \"OK\";\n}\n\nexport default function script(event: InputEvent): MissionStatus | undefined {\n  const now = seconds(event.receiveTime);\n  if (event.topic === \"/sim/status\") {\n    try {\n      lastStatus = JSON.parse(event.message.data);\n      lastStatusTime = now;\n    } catch {\n      lastStatus = { state: \"unparseable_status\" };\n      lastStatusTime = now;\n    }\n  }\n  if (lastStatusTime === undefined) {\n    return undefined;\n  }\n  if (now < lastStatusTime) {\n    // Playback was moved backwards; wait for the next status message.\n    lastStatus = undefined;\n    lastStatusTime = undefined;\n    return undefined;\n  }\n\n  const statusAge = now - lastStatusTime;\n  const link = statusAge <= STATUS_STALE_S ? \"OK\" : \"STALE\";\n  const origin = lastStatus.source === \"gazebo_simulation\" ? \"SIMULATED\" : \"UNLABELLED\";\n  const scan = freshness(lastStatus.scan_age_s, SCAN_STALE_S);\n  const pose = freshness(lastStatus.pose_age_s, POSE_STALE_S);\n  const reported = typeof lastStatus.state === \"string\" ? lastStatus.state : \"unknown\";\n  const state = link === \"OK\" ? reported : \"status_stale\";\n\n  return {\n    state,\n    data_origin: origin,\n    warning: warningFor(reported, link, scan, pose, origin),\n    status_link: link,\n    scan,\n    pose,\n    status_age_s: statusAge,\n    scan_age_s: typeof lastStatus.scan_age_s === \"number\" ? lastStatus.scan_age_s : -1,\n    pose_age_s: typeof lastStatus.pose_age_s === \"number\" ? lastStatus.pose_age_s : -1,\n    simulation_time_s: typeof lastStatus.simulation_time_s === \"number\" ? lastStatus.simulation_time_s : -1,\n    // No battery, E-stop or fault topic exists yet; these panels must read UNAVAILABLE.\n    battery: \"NO_INPUT\",\n    estop: \"NO_INPUT\",\n    faults: \"NO_INPUT\",\n  };\n}\n"
    },
    "operator-camera_health": {
      "name": "camera_health",
      "sourceCode": "// Camera freshness for the operator display (display only: nothing is sent to ROS).\n// /tf is used only as a heartbeat so a camera that stops is reported as STALE.\n// 2.0 s matches camera_timeout in lunabotics_autonomy/autonomy/types.py.\n\nexport const inputs = [\"/sim/camera/image\", \"/tf\"];\nexport const output = \"/studio_script/camera_health\";\n\ntype Time = { sec: number; nsec: number };\ntype InputEvent = { topic: string; receiveTime: Time; message: any };\n\ntype CameraHealth = {\n  camera: string;\n  camera_age_s: number;\n};\n\nconst CAMERA_STALE_S = 2.0;\n\nlet lastImageTime: number | undefined = undefined;\n\nfunction seconds(t: Time): number {\n  return t.sec + t.nsec * 1e-9;\n}\n\nexport default function script(event: InputEvent): CameraHealth | undefined {\n  const now = seconds(event.receiveTime);\n  if (event.topic === \"/sim/camera/image\") {\n    lastImageTime = now;\n  }\n  if (lastImageTime === undefined) {\n    return { camera: \"NO_DATA\", camera_age_s: -1 };\n  }\n  if (now < lastImageTime) {\n    // Playback was moved backwards; wait for the next image.\n    lastImageTime = undefined;\n    return { camera: \"NO_DATA\", camera_age_s: -1 };\n  }\n  const age = now - lastImageTime;\n  return { camera: age <= CAMERA_STALE_S ? \"OK\" : \"STALE\", camera_age_s: age };\n}\n"
    },
    "operator-rover_footprint": {
      "name": "rover_footprint",
      "sourceCode": "// Rover footprint for the 3D panel (display only: nothing is sent to ROS).\n// The 3D panel cannot draw nav_msgs/Odometry, so each /sim/odom message produces a box\n// attached to base_link. Size is the simulated chassis (arena.sdf: 0.65 x 0.45 x 0.16 m\n// at z = 0.25 m); these are development values, not measured rover dimensions.\n\nimport { Message } from \"./types\";\nimport { buildRosMarker, MarkerTypes } from \"./markers\";\n\nexport const inputs = [\"/sim/odom\"];\nexport const output = \"/studio_script/rover_footprint\";\n\ntype Time = { sec: number; nsec: number };\ntype InputEvent = { topic: string; receiveTime: Time; message: any };\ntype Marker = Message<\"visualization_msgs/Marker\">;\n\nexport default function script(event: InputEvent): Marker {\n  return buildRosMarker({\n    header: { frame_id: \"base_link\", stamp: event.receiveTime, seq: 0 },\n    ns: \"sim_rover_footprint\",\n    id: 0,\n    type: MarkerTypes.CUBE,\n    action: 0,\n    frame_locked: true,\n    pose: {\n      position: { x: 0, y: 0, z: 0.25 },\n      orientation: { x: 0, y: 0, z: 0, w: 1 },\n    },\n    scale: { x: 0.65, y: 0.45, z: 0.16 },\n    color: { r: 1.0, g: 0.6, b: 0.0, a: 0.6 },\n  });\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
  },
  "layout": "Tab!main"
}
