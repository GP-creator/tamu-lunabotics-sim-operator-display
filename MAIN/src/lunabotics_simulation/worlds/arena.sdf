          <material>
            <ambient>.3 .3 .35 1</ambient>
            <diffuse>.3 .3 .35 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="front_caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>front_caster</child>
      </joint>
      <link name="rear_caster">
        <pose>-0.23 0 .06 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.003</izz>
