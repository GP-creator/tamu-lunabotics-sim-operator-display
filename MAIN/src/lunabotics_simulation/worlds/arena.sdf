        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.065</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>.3 .3 .35 1</ambient>
            <diffuse>.3 .3 .35 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
        </axis>
      </joint>
      <link name="front_caster">
        <pose>0.23 0 .06 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.003</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
