    <model name="sim_rover">
      <pose>1.2 1.2 .01 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>12</mass>
          <inertia>
            <ixx>0.24</ixx>
            <iyy>0.24</iyy>
            <izz>0.36</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
          <pose>0 0 .25 0 0 0</pose>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>.65 .45 .16</size>
            </box>
          </geometry>
          <pose>0 0 .25 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>.65 .45 .16</size>
            </box>
          </geometry>
          <material>
            <ambient>.15 .25 .7 1</ambient>
            <diffuse>.15 .25 .7 1</diffuse>
          </material>
          <pose>0 0 .25 0 0 0</pose>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 .42 0 0 0</pose>
          <topic>/sim/scan</topic>
          <gz_frame_id>base_scan</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265359</min_angle>
                <max_angle>3.14159265359</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>12</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
        <sensor name="imu" type="imu">
          <pose>0 0 .25 0 0 0</pose>
          <topic>/sim/imu</topic>
          <gz_frame_id>imu_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <imu />
        </sensor>
        <sensor name="camera" type="camera">
          <pose>.25 0 .35 0 0 0</pose>
          <topic>/sim/camera/image</topic>
          <gz_frame_id>camera_link</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20</far>
            </clip>
            <camera_info_topic>/sim/camera/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.3 .15 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.016</ixx>
            <iyy>0.016</iyy>
            <izz>0.024</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.065</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.065</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>.3 .3 .35 1</ambient>
            <diffuse>.3 .3 .35 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
        </axis>
      </joint>
      <link name="right_wheel">
        <pose>0 -0.3 .15 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.016</ixx>
            <iyy>0.016</iyy>
            <izz>0.024</izz>
            <ixy>0</ixy>
