  "userNodes": {
    "gnc-pose_health": {
      "name": "pose_health",
      "sourceCode": "// Pose freshness for the operator display (display only: nothing is sent to ROS).\n// /tf is used only as a heartbeat so a Pose topic that stops is reported as STALE.\n// 0.5 s matches the GNC-2027 path planner pose timeout.\n\nexport const inputs = [\"/odometry/filtered\", \"/tf\"];\nexport const output = \"/studio_script/pose_health\";\n\ntype Time = { sec: number; nsec: number };\ntype InputEvent = { topic: string; receiveTime: Time; message: any };\n\ntype Health = {\n  pose: string;\n  pose_age_s: number;\n};\n\nconst STALE_S = 0.5;\n\nlet lastTime: number | undefined = undefined;\n\nfunction seconds(t: Time): number {\n  return t.sec + t.nsec * 1e-9;\n}\n\nexport default function script(event: InputEvent): Health | undefined {\n  const now = seconds(event.receiveTime);\n  if (event.topic === \"/odometry/filtered\") {\n    lastTime = now;\n  }\n  if (lastTime === undefined) {\n    return { pose: \"NO_DATA\", pose_age_s: -1 };\n  }\n  if (now < lastTime) {\n    // Playback was moved backwards; wait for the next message.\n    lastTime = undefined;\n    return { pose: \"NO_DATA\", pose_age_s: -1 };\n  }\n  const age = now - lastTime;\n  return { pose: age <= STALE_S ? \"OK\" : \"STALE\", pose_age_s: age };\n}\n"
    },
    "gnc-imu_health": {
      "name": "imu_health",
      "sourceCode": "// IMU freshness for the operator display (display only: nothing is sent to ROS).\n// /tf is used only as a heartbeat so a IMU topic that stops is reported as STALE.\n// 0.5 s is a display choice; GNC-2027 defines no IMU timeout yet.\n\nexport const inputs = [\"/imu/data_raw\", \"/tf\"];\nexport const output = \"/studio_script/imu_health\";\n\ntype Time = { sec: number; nsec: number };\ntype InputEvent = { topic: string; receiveTime: Time; message: any };\n\ntype Health = {\n  imu: string;\n  imu_age_s: number;\n};\n\nconst STALE_S = 0.5;\n\nlet lastTime: number | undefined = undefined;\n\nfunction seconds(t: Time): number {\n  return t.sec + t.nsec * 1e-9;\n}\n\nexport default function script(event: InputEvent): Health | undefined {\n  const now = seconds(event.receiveTime);\n  if (event.topic === \"/imu/data_raw\") {\n    lastTime = now;\n  }\n  if (lastTime === undefined) {\n    return { imu: \"NO_DATA\", imu_age_s: -1 };\n  }\n  if (now < lastTime) {\n    // Playback was moved backwards; wait for the next message.\n    lastTime = undefined;\n    return { imu: \"NO_DATA\", imu_age_s: -1 };\n  }\n  const age = now - lastTime;\n  return { imu: age <= STALE_S ? \"OK\" : \"STALE\", imu_age_s: age };\n}\n"
    },
    "gnc-footprint": {
      "name": "gnc_footprint",
      "sourceCode": "// Rover footprint for the 3D panel (display only: nothing is sent to ROS).\n// Box attached to base_link, driven by /odometry/filtered. Size from GNC-2027\n// luna_description/config/robot_geometry.yaml (1.0 x 0.7 x 0.4 m, marked ASSUMPTION there).\n\nimport { Message } from \"./types\";\nimport { buildRosMarker, MarkerTypes } from \"./markers\";\n\nexport const inputs = [\"/odometry/filtered\"];\nexport const output = \"/studio_script/gnc_footprint\";\n\ntype Time = { sec: number; nsec: number };\ntype InputEvent = { topic: string; receiveTime: Time; message: any };\ntype Marker = Message<\"visualization_msgs/Marker\">;\n\nexport default function script(event: InputEvent): Marker {\n  return buildRosMarker({\n    header: { frame_id: \"base_link\", stamp: event.receiveTime, seq: 0 },\n    ns: \"gnc_rover_footprint\",\n    id: 0,\n    type: MarkerTypes.CUBE,\n    action: 0,\n    frame_locked: true,\n    pose: {\n      position: { x: 0, y: 0, z: 0.35 },\n      orientation: { x: 0, y: 0, z: 0, w: 1 },\n    },\n    scale: { x: 1.0, y: 0.7, z: 0.4 },\n    color: { r: 1.0, g: 0.6, b: 0.0, a: 0.6 },\n  });\n}\n"
    }
  },
